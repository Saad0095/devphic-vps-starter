# ==============================================================================
# Devphic VPS Starter — Environment Configuration Template
# Copy this file to .env before starting the stack: cp .env.example .env
# ==============================================================================

# Application Environment (production, development, test)
NODE_ENV=production

# Server Port & Binding
# Note: In production with Docker, the app listens on 3000 inside the container.
# Nginx proxies public traffic (80/443) to this port.
PORT=3000
HOST=0.0.0.0

# Service Identification
APP_NAME="Devphic VPS Starter API"
APP_VERSION=1.0.0

# Security & CORS
# In production, replace with your exact front-end domain (e.g., https://example.com)
CORS_ORIGIN=*

# Reverse Proxy Trust (Set to true when running behind Nginx / Cloudflare)
TRUST_PROXY=true

# Graceful Shutdown Timeout (milliseconds to wait for in-flight requests)
SHUTDOWN_TIMEOUT_MS=10000

# Application Secret Key (Used for session tokens, JWTs, hashing)
# Generated automatically by setup.sh or run: openssl rand -hex 32
APP_SECRET=replace_with_a_secure_random_hex_key_minimum_32_chars

# Domain & SSL (Used by setup.sh, Nginx, and Certbot)
DOMAIN=example.com
LETSENCRYPT_EMAIL=admin@example.com
